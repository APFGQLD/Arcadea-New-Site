# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# Sanity project — public read access (safe to expose to the browser, hence
# the VITE_ prefix which Vite bundles into client-side code)
VITE_SANITY_PROJECT_ID=b6pkfjxp
VITE_SANITY_DATASET=production

# Sanity write token — used only by the standalone Node scripts in scripts/
# (run directly with `node`, never bundled by Vite). The VITE_ prefix here
# is safe ONLY because nothing under src/ imports it — Vite inlines any
# VITE_-prefixed variable it sees referenced via import.meta.env into the
# public client bundle, so this must never be imported from src/.
# Generate one at https://www.sanity.io/manage/project/b6pkfjxp/api#tokens
# with "Editor" permissions (not Administrator).
VITE_SANITY_WRITE_TOKEN=
