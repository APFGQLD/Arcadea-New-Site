# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Secrets — never commit real credentials
.env
.env.*
!.env.example

# Sanity Studio build output & CLI runtime cache — Hostinger builds this
# site itself (npm run build -> dist/), and Studio is embedded at /studio
# in that same build, so the standalone studio/ project's own artifacts
# never need to be committed.
studio/dist
studio/.sanity

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
