<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Canonicalize on www — arcadea.com.au and www.arcadea.com.au currently
  # serve identical content with no redirect, which splits SEO signals
  # between two domains. Force everything onto the www version.
  RewriteCond %{HTTP_HOST} ^arcadea\.com\.au$ [NC]
  RewriteRule ^(.*)$ https://www.arcadea.com.au/$1 [L,R=301]

  RewriteRule ^index\.html$ - [L]

  # Serve a prerendered directory's index.html directly at the
  # no-trailing-slash URL instead of letting Apache's default
  # DirectorySlash behaviour 301-redirect to add the slash. A URL
  # fragment (e.g. /properties#coastal) is never sent to the server, so
  # it relies on the browser re-attaching it after that redirect — which
  # isn't reliable across browsers. Serving the same content directly,
  # with no redirect, avoids that entirely.
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*[^/])$ $1/index.html [L]

  # Everything else is a client-side route: serve the bare app shell.
  # Not index.html — that's the homepage, prerendered with homepage links
  # and canonical (prerender.js writes app.html as a clean copy).
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /app.html [L]
</IfModule>

<IfModule mod_dir.c>
  # Belt-and-suspenders: without this, Apache's own directory handler can
  # still redirect to add a trailing slash before mod_rewrite's rule above
  # gets a chance to serve the file directly. Safe here since every asset
  # is referenced with an absolute path (vite.config.js base: '/'), so
  # nothing depends on the trailing slash for relative URL resolution.
  DirectorySlash Off
</IfModule>

<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
  AddType application/json .json
</IfModule>

# Enable GZIP Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

# Browser Caching
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"
</IfModule>

# Security Headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-XSS-Protection "1; mode=block"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
